# Apache / LiteSpeed configuration for https://firstcapital.lk/begininvesting/
Options -Indexes +FollowSymLinks
DirectoryIndex index.html index.php

# Security: block dotfiles (.env, .git), SQL dumps, SQLite databases, docs, JSON data files and logs
<FilesMatch "(^\.|\.(sql|sqlite|db|md|json|log|zip|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  ErrorDocument 404 /fc/404.html
  ErrorDocument 403 /fc/404.html

  # 0. Direct route for root to index.html (prevents 403 Forbidden directory listing on LiteSpeed)
  RewriteRule ^$ index.html [L]

  # 0b. Serve robots.txt directly with text/plain
  RewriteRule ^robots\.txt$ robots.txt [L]

  # 1. Enforce trailing slash for subdirectories
  RewriteRule ^admin$ admin/ [R=301,L]
  RewriteRule ^admin\.html$ admin/ [R=301,L]
  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^design-option-2$ design-option-2/ [R=301,L]
  RewriteRule ^design-option-2/?$ design-option-2/index.html [L]
  RewriteRule ^firstcapitalpages$ firstcapitalpages/ [R=301,L]

  # 2. Serve existing files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Dual-path fallback: If assets/filename.png is requested but only filename.png exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.+)$ $1 [L]

  # 3b. Dual-path fallback: If filename.png is requested but only assets/filename.png exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^/]+\.(png|jpg|jpeg|svg|gif|webp|ico))$ assets/$1 [L]

  # 4. Do NOT rewrite backend scripts
  RewriteRule \.php$ - [L]

  # 5. Route personality share links cleanly
  RewriteRule ^(keep-it-cool|smooth-operator|patient-player|opportunity-hunter)(-(?:male|female))?/?$ $1$2.html [L]

  # 6. Fallback if index.html is in firstcapitalpages/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^$ firstcapitalpages/index.html [L]
</IfModule>

# Security headers (API is same-origin only)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header set X-Robots-Tag "all"
  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=utf-8"
  </Files>
</IfModule>

# Enable Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

