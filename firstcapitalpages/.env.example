# ==============================================================================
# First Capital - Production MySQL Database Configuration
# Production Domain: https://investor.firstcapital.lk/
# ==============================================================================
# Enter your MySQL database credentials below.
# On Hostinger: Obtain these from hPanel -> Databases -> MySQL Databases.

# MySQL Database Host (usually localhost for shared hosting / Hostinger)
DB_HOST=localhost

# MySQL Database Port (default: 3306)
DB_PORT=3306

# MySQL Database Name
DB_NAME=firstcapital_investor

# MySQL Database Username
DB_USER=firstcapital_user

# MySQL Database Password
DB_PASSWORD=your_db_password_here
DB_PASS=your_db_password_here
