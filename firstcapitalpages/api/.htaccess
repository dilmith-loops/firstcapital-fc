# ==============================================================================
# First Capital API Security & Endpoint Gatekeeper
# Target Path: https://firstcapital.lk/begininvesting/api/
# ==============================================================================

# Block direct access to helpers, database connections, schema, and dotfiles
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

# ------------------------------------------------------------------------------
# 1. PUBLIC ENDPOINTS (Completely open to all visitors 0.0.0.0/0)
# leads.php handles public quiz content retrieval and lead capture submissions
# ------------------------------------------------------------------------------
<FilesMatch "^leads\.php$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Allow from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION ENDPOINT (Restricted to Whitelisted IPs Only)
# auth.php manages session login/logout and admin user management
# ------------------------------------------------------------------------------
<FilesMatch "^auth\.php$">
  # Reverse-Proxy / Imperva Incapsula / Cloudflare Filter
  <IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REMOTE_ADDR} ^112\.134\.215\.162$ [OR]
    RewriteCond %{HTTP:Incap-Client-IP} ^112\.134\.215\.162$ [OR]
    RewriteCond %{HTTP:X-Forwarded-For} (^|,)\s*112\.134\.215\.162 [OR]
    RewriteCond %{HTTP:CF-Connecting-IP} ^112\.134\.215\.162$ [OR]
    RewriteCond %{REMOTE_ADDR} ^2402:d000:8134: [OR]
    RewriteCond %{HTTP:X-Forwarded-For} (^|,)\s*2402:d000:8134: [OR]
    RewriteCond %{REMOTE_ADDR} ^127\.0\.0\.1$ [OR]
    RewriteCond %{REMOTE_ADDR} ^::1$ [OR]
    # First Capital Corporate HQ Static IP (Uncomment & configure):
    # RewriteCond %{REMOTE_ADDR} ^203\.0\.113\.50$ [OR]
    # RewriteCond %{HTTP:X-Forwarded-For} (^|,)\s*203\.0\.113\.50 [OR]
    # RewriteCond %{HTTP:Incap-Client-IP} ^203\.0\.113\.50$ [OR]
    RewriteCond %{REMOTE_ADDR} ^999\.999\.999\.999$
    RewriteRule ^ - [E=FC_AUTH_ALLOWED:1]

    RewriteCond %{ENV:FC_AUTH_ALLOWED} !^1$
    RewriteRule ^ - [F,L]
  </IfModule>

  # Native Apache 2.4 mod_authz_core Direct Rule
  <IfModule mod_authz_core.c>
    <RequireAny>
      Require ip 112.134.215.162
      Require ip 2402:d000:8134::/48
      Require ip 127.0.0.1
      Require ip ::1
      # Require ip 203.0.113.50
      Require env FC_AUTH_ALLOWED
    </RequireAny>
  </IfModule>

  # Legacy Apache 2.2 Fallback
  <IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
    Allow from 112.134.215.162
    Allow from 127.0.0.1
    Allow from ::1
    Allow from env=FC_AUTH_ALLOWED
  </IfModule>
</FilesMatch>
