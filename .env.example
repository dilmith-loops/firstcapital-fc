# ==============================================================================
# First Capital - Production MySQL Database Configuration
# Production Domain: https://investor.firstcapital.lk/
# ==============================================================================
# Enter your MySQL database credentials below.
# On Hostinger: Obtain these from hPanel -> Databases -> MySQL Databases.

# MySQL Database Host (usually localhost for shared hosting / Hostinger)
DB_HOST=localhost

# MySQL Database Port (default: 3306)
DB_PORT=3306

# MySQL Database Name
DB_NAME=firstcapital_investor

# MySQL Database Username
DB_USER=firstcapital_user

# MySQL Database Password
DB_PASSWORD=your_db_password_here
DB_PASS=your_db_password_here

# ==============================================================================
# First Capital - SMTP Email Configuration
# Sends user details, quiz results (Q1-Q7 answers), and final investor result to Admin
# ==============================================================================
# Set to true to enable automated email notifications on quiz completion
SMTP_ENABLED=true

# Admin recipient email where all leads and quiz results are sent
ADMIN_EMAIL=admin@firstcapital.lk

# Outgoing SMTP mail server (e.g. smtp.hostinger.com, smtp.gmail.com, mail.firstcapital.lk)
SMTP_HOST=smtp.hostinger.com

# SMTP Port: 465 (for SSL) or 587 (for TLS/STARTTLS)
SMTP_PORT=465

# Encryption protocol: ssl or tls
SMTP_SECURE=ssl

# SMTP authentication username / mailbox email
SMTP_USER=leads@firstcapital.lk

# SMTP authentication password
SMTP_PASS=your_smtp_password_here

# From email address shown on notifications (leave blank to default to SMTP_USER)
SMTP_FROM_EMAIL=leads@firstcapital.lk

# From name shown on notifications
SMTP_FROM_NAME="First Capital Investor Week"
